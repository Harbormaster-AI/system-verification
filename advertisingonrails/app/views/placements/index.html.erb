<div class="title text-center">
  List of Placements
</div>

<table class="table table-sm table-hover table-striped"">
	<thead class="table-dark">
		<tr>

			<th style="text-align:center">name</th>
			<th style="text-align:center">flight</th>
			<th style="text-align:center">goalImpressions</th>
			<th style="text-align:center" colspan="2">Actions</th>
	</thead>
	<tbody>
 
  <% @placements.each do |placement| %>
		<tr>   
			<td style="text-align:center">
	  			<%= placement.name %>
			</td>
			<td style="text-align:center">
	  			<%= placement.flight %>
			</td>
			<td style="text-align:center">
	  			<%= placement.goalImpressions %>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Change', edit_placement_path(placement), :method => :get, :class => "btn btn-secondary btn-sm"%>
			</td>
			<td style="vertical-align:middle;text-align:center">
				<%= button_to 'Delete', placement_path(placement), :method => :delete, data: { confirm: 'Are you sure?' }, :class => "btn btn-danger btn-sm"%>
			</td>
    	</tr>
  <% end %>
</table>
<%= button_to 'New Placement', new_placement_path, :method => :get, :class => "btn btn-success btn-sm" %>